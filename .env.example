PORT=5000
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email@project.iam.gserviceaccount.com"
MONGO_URI="mongodb://user:pass@cluster.mongodb.net/news-nest?retryWrites=true&w=majority"
JWT_SECRET=your-jwt-secret-key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# External APIs
CURRENTS_API_KEY=your_currents_api_key
YOUTUBE_API_KEY=your_youtube_api_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# Redis Configuration (Local or Upstash)
REDIS_URL=redis://127.0.0.1:6379
UPSTASH_REDIS_URL=

# FastAPI News Scraper Microservice
FASTAPI_SCRAPER_URL=http://127.0.0.1:8000
NEWS_APP_USER_AGENT="NewsNests/1.0 (+http://localhost:5174)"
PUBLIC_APP_URL="http://localhost:5174"
SCRAPER_EXTRACTION_CONCURRENCY=4

# n8n Automation Engine
N8N_AUTOMATION_KEY=your-n8n-shared-automation-key-min-24-chars
N8N_ARTICLE_WEBHOOK_URL=http://127.0.0.1:5678/webhook/article-approved
