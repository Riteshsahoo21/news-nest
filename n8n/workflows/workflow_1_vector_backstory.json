        "options": {}
      },
      "id": "a1058a65-cf34-447e-b63f-e5c1296b5144",
      "name": "Article Approved Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-900, -120],
      "webhookId": "467a5d3a-a7bd-4930-a2b0-5bde54ad883f"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "4af00a04-f09d-4df2-9923-acde907d3782",
      "name": "Backfill Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-900, 120]
    },
    {
      "parameters": {
        "url": "={{ ($env.NEWS_NEST_API_URL || 'https://news.ritzla.in') + '/api/automation/news/semantic-pending?limit=10' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-key",
              "value": "={{$env.N8N_AUTOMATION_KEY}}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "7b22b824-e9c7-44d8-b930-32ec1e24ea9e",
      "name": "Fetch Unlinked Articles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-680, 120]
    },
    {
      "parameters": {
        "jsCode": "const articles = Array.isArray($json.articles) ? $json.articles : [];\nreturn articles.map((article) => ({ json: article }));"
      },
      "id": "40f1e5ab-8db7-4d34-9bb9-ec2db50cc56e",
      "name": "Expand Semantic Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-460, 120]
    },
    {
      "parameters": {
        "jsCode": "const expectedKey = String($env.N8N_AUTOMATION_KEY || '');\nconst validItems = [];\n$input.all().forEach((item, index) => {\n  const envelope = item.json || {};\n  if (envelope.body) {\n    const suppliedKey = String(envelope.headers?.['x-automation-key'] || envelope.headers?.['X-Automation-Key'] || '');\n    if (!expectedKey || suppliedKey !== expectedKey) throw new Error('Unauthorized article webhook request');\n  }\n  const source = envelope.body || envelope.article || envelope;\n  const articleId = String(source.articleId || source._id || '');\n  if (!/^[a-f0-9]{24}$/i.test(articleId)) return;\n  const title = String(source.title || '').trim();\n  if (!title) return;\n  const tags = Array.isArray(source.tags) ? source.tags : [];\n  validItems.push({\n    json: {\n      articleId,\n      title,\n      subtitle: String(source.subtitle || ''),\n      category: String(source.category || 'general'),\n      tags,\n      slug: String(source.slug || ''),\n      aiSummary: String(source.aiSummary || ''),\n      publishedAt: source.publishedAt || source.createdAt || new Date().toISOString()\n    },\n    pairedItem: { item: index }\n  });\n});\nreturn validItems;"
      },
      "id": "64d99c1a-b0f9-48a2-97bb-86c3eaf350e3",
      "name": "Normalize Article",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-220, -20]
    },
    {
      "parameters": {
        "url": "={{ ($env.NEWS_NEST_API_URL || 'https://news.ritzla.in') + '/api/news/related?articleId=' + $json.articleId + '&category=' + encodeURIComponent($json.category) + '&tags=' + encodeURIComponent($json.tags.join(',')) + '&title=' + encodeURIComponent($json.title) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "f5120d58-95a7-47b2-bdcb-65231c6a2871",
      "name": "Resolve Multi-Tier Companions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, -20]
    },
    {
      "parameters": {
        "jsCode": "const sourceList = $('Normalize Article').all();\nreturn $input.all().map((item, index) => {\n  const source = sourceList[index]?.json || sourceList[0]?.json || {};\n  const rawMatches = Array.isArray(item.json) ? item.json : (item.json?.relatedArticles || []);\n  const relatedIds = rawMatches\n    .map((m) => String(m._id || m.articleId || ''))\n    .filter((id) => /^[a-f0-9]{24}$/i.test(id) && id !== source.articleId)\n    .slice(0, 3);\n  return {\n    json: {\n      articleId: source.articleId,\n      relatedArticles: relatedIds,\n      isDuplicateEcho: false,\n      embeddingId: 'mongo_multitier_' + source.articleId\n    },\n    pairedItem: { item: index }\n  };\n});"
      },
      "id": "cf64560b-85d7-4be7-a9a7-4b726cf94a46",
      "name": "Prepare Semantic Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, -20]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ ($env.NEWS_NEST_API_URL || 'https://news.ritzla.in') + '/api/automation/news/' + $json.articleId + '/semantic' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-key",
              "value": "={{$env.N8N_AUTOMATION_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { relatedArticles: $json.relatedArticles, isDuplicateEcho: $json.isDuplicateEcho, embeddingId: $json.embeddingId } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "4b54e7d4-e6df-40ec-8367-fa6d2745cb57",
      "name": "Save Links and Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, -20]
    }
  ],
  "connections": {
