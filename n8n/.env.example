# Copy this file to .env, or run setup.ps1 to create it.
N8N_VERSION=latest
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_AUTOMATION_KEY=replace-with-the-same-long-random-value-used-by-the-backend

# Google AI Studio key used for newsletter and AI summary generation
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_TEXT_MODEL=gemini-flash-lite-latest

# These defaults work when n8n runs in Docker and the project services run on Windows or VPS.
NEWS_NEST_API_URL=http://host.docker.internal:5000
NEWS_NEST_SCRAPER_URL=http://host.docker.internal:8000
NEWS_NEST_PUBLIC_URL=http://localhost:5174
